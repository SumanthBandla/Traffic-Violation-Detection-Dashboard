# --- Application ---
APP_NAME=AI Traffic Violation Detection System
DEBUG=true

# --- Security ---
SECRET_KEY=change-me-in-production-9f8a7b6c5d4e3f2a1b0c
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (SQLite default for demo) ---
# For Postgres (docker-compose):
# DATABASE_URL=postgresql+psycopg2://traffic:traffic123@localhost:5432/traffic_db
DATABASE_URL=sqlite:///./traffic.db

# --- Redis (optional) ---
REDIS_URL=

# --- AI ---
# demo = synthetic detection (no weights required)
# live = real YOLO/OCR models (requires weights)
AI_MODE=demo
YOLO_MODEL_PATH=weights/yolov11n.pt
CONFIDENCE_THRESHOLD=0.35

# --- Evidence ---
EVIDENCE_DIR=storage/evidence
ENCRYPT_EVIDENCE=false
EVIDENCE_RETENTION_DAYS=180

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

