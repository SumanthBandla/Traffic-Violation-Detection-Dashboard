# --- Application ---
APP_NAME=AI Traffic Violation Detection System
DEBUG=true

# --- Security ---
# CHANGE THIS in production. Shared between backend (JWT signing).
SECRET_KEY=change-me-in-production-9f8a7b6c5d4e3f2a1b0c
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (SQLite default for demo) ---
# For Postgres (docker-compose):
# DATABASE_URL=postgresql+psycopg2://traffic:traffic123@localhost:5432/traffic_db
DATABASE_URL=sqlite:///./traffic.db

# --- Redis (optional; falls back to in-memory) ---
REDIS_URL=

# --- AI ---
# demo = synthetic detection (no weights required)
# live = real YOLO/OCR models (requires weights)
AI_MODE=demo
YOLO_MODEL_PATH=weights/yolov11n.pt
CONFIDENCE_THRESHOLD=0.35

# --- Streaming / mobile camera ingest ---
# Frames received from mobile cameras are downscaled to this max width and
# broadcast to dashboard viewers.
STREAM_MAX_FPS=15
STREAM_MAX_WIDTH=960
STREAM_QUALITY=80
# A mobile camera is considered offline if no heartbeat arrives within this window.
HEALTH_STALE_AFTER_SECONDS=30

# --- Evidence ---
EVIDENCE_DIR=storage/evidence
ENCRYPT_EVIDENCE=false
EVIDENCE_RETENTION_DAYS=180

# --- CORS ---
# Comma-separated list. Add your Vite dev ports and any deployed frontend origin.
# The mobile PWA must be served from a secure origin (https) to access camera/geolocation.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4173"]
